# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Environment (development, staging, production)
APP_ENV=development

# CORS Configuration - Replace chrome-extension-id with your actual extension ID
CORS_ORIGINS=["http://localhost:5173","chrome-extension://your-chrome-extension-id-here"]

# Rate Limiting
RATE_LIMIT=10/minute

# Max code size for scanning
MAX_CODE_SIZE_KB=500

# Request timeout in seconds
REQUEST_TIMEOUT=30

# Cache settings
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300